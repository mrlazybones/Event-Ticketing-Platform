# Copy this file to .env (which Git ignores) and adjust the values for your machine.
# This template is committed, so never put real credentials in it.
#
# Spring Boot does not load .env. scripts/dev.ps1 and scripts/dev.sh export these
# variables into the process that starts the application. An IDE run does not,
# unless the IDE is configured with the same variables; the dev profile then uses
# the placeholders written in application-dev.yml.

# Spring profile(s) to activate. When unset, the application falls back to "dev".
SPRING_PROFILES_ACTIVE=dev

# HTTP port of the API.
SERVER_PORT=8080

# Local PostgreSQL placeholders. They are not production credentials.
# Docker Compose reads this file for DB_NAME, DB_USERNAME, DB_PASSWORD and DB_HOST_PORT.
# Spring Boot does not. The app reads DB_URL, DB_USERNAME and DB_PASSWORD, and only when a
# dev script or your IDE exports them. The port in DB_URL must match DB_HOST_PORT, and the
# database name in DB_URL must match DB_NAME.
DB_HOST_PORT=5432
DB_NAME=event_ticketing
DB_URL=jdbc:postgresql://localhost:5432/event_ticketing
DB_USERNAME=event_ticketing
DB_PASSWORD=event_ticketing
